# LLM API Configuration
# Copy this file to .env and fill in your actual API credentials

# OpenAI API (or compatible API endpoint)
VITE_LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_LLM_API_KEY=your-api-key-here

# Alternative providers:
# For Anthropic Claude:
# VITE_LLM_API_ENDPOINT=https://api.anthropic.com/v1/messages
# VITE_LLM_API_KEY=your-anthropic-key-here

# For local LLM (e.g., Ollama):
# VITE_LLM_API_ENDPOINT=http://localhost:11434/api/chat
# VITE_LLM_API_KEY=not-required-for-local
