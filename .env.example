# Backend grading service configuration.
# Copy this file to .env and fill in your key:  cp .env.example .env
#
# These are read by server.js only. Do NOT use a VITE_ prefix for secrets -
# Vite inlines VITE_* variables into the client bundle, exposing them to anyone
# who opens the page.

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_MS=45000
# GROQ_MAX_TOKENS=2000
# Set to 'none' for hybrid reasoning models (e.g. qwen3.x) that would
# otherwise spend the whole token budget thinking.
# GROQ_REASONING_EFFORT=
# PORT=3001

# Optional (frontend): point the client at a backend on another origin.
# Leave unset to use the Vite dev proxy / same-origin deployment.
# VITE_API_BASE_URL=
